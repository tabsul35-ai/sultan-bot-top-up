# === DISCORD BOT ===
# Ambil dari https://discord.com/developers/applications -> aplikasi Anda -> Bot -> Token
DISCORD_TOKEN=

# Ambil dari halaman "General Information" aplikasi Anda -> Application ID
DISCORD_CLIENT_ID=

# ID server Discord Anda (klik kanan nama server -> Copy Server ID, aktifkan Developer Mode dulu di Settings > Advanced)
# Diisi supaya command langsung muncul instan saat development. Kosongkan jika ingin deploy global (butuh waktu ~1 jam).
DISCORD_GUILD_ID=

# === DATABASE ===
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sultan_topup

# === STOK ROBUX LIVE ===
# Tidak ada env var untuk ini - akun Roblox diatur langsung dari Discord lewat
# /admin addrobloxaccount (maks 5 akun), tidak perlu edit file .env. Lihat DEPLOY-VPS.md.

# === MANAJEMEN AKUN REDFINGER (/redfinger) - semua opsional ===
# Channel admin/log & role diatur dari Discord: /redfinger setup admin_channel:#.. log_channel:#.. role:@..

# Kunci enkripsi password akun Redfinger (AES-256-GCM, 32 byte base64 atau 64 karakter hex).
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kosong = bot menolak menyimpan password. JANGAN diganti/hilang - password lama jadi tidak terbaca.
REDFINGER_ENCRYPTION_KEY=

# Tahap pengingat (hari sebelum jatuh tempo), dipisah koma. Notifikasi "sudah habis" selalu dikirim.
REDFINGER_REMINDER_DAYS=7,3,1
# Interval scheduler cek masa aktif (menit)
REDFINGER_CHECK_INTERVAL_MINUTES=30
# Zona waktu input/tampilan tanggal: 7=WIB, 8=WITA, 9=WIT
REDFINGER_UTC_OFFSET_HOURS=7

# Mode renew default: manual (checklist untuk admin) atau browser (Playwright)
REDFINGER_RENEW_MODE=manual

# --- Redfinger Manager (Register/sinkron device otomatis via Playwright) ---
# Sekali di server: npx playwright install --with-deps chromium
# Bot login ke cloudemulator.net & membaca device + masa aktif. TIDAK membayar, TIDAK melewati CAPTCHA/OTP/MFA.
REDFINGER_BROWSER_ENABLED=false
REDFINGER_BROWSER_HEADLESS=true
REDFINGER_BROWSER_TIMEOUT_MS=120000
# Sinkron ulang otomatis akun login tiap N jam (0 = mati)
REDFINGER_SYNC_INTERVAL_HOURS=12
