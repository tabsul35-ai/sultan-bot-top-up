# === DISCORD BOT ===
# Ambil dari https://discord.com/developers/applications -> aplikasi Anda -> Bot -> Token
DISCORD_TOKEN=

# Ambil dari halaman "General Information" aplikasi Anda -> Application ID
DISCORD_CLIENT_ID=

# ID server Discord Anda (klik kanan nama server -> Copy Server ID, aktifkan Developer Mode dulu di Settings > Advanced)
# Diisi supaya command langsung muncul instan saat development. Kosongkan jika ingin deploy global (butuh waktu ~1 jam).
DISCORD_GUILD_ID=

# === DATABASE ===
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sultan_topup

# === STOK ROBUX LIVE (opsional) ===
# Cookie sesi ".ROBLOSECURITY" akun Roblox yang dipakai jualan, dipakai bot untuk membaca
# saldo Robux akun itu secara berkala dan menjadikannya "stok" otomatis.
# Cara ambil: login ke akun Roblox (SEBAIKNYA akun khusus jualan, BUKAN akun utama) di
# browser -> F12 (DevTools) -> tab Application/Storage -> Cookies -> roblox.com -> cari
# ".ROBLOSECURITY" -> copy value-nya (panjang, diawali "_|WARNING:-DO-NOT-SHARE-THIS...").
#
# !! SANGAT SENSITIF - setara password penuh akun itu (bisa transfer Robux, ganti password
# akun, dll kalau bocor). JANGAN commit ke git, jangan share ke siapa pun, jangan tempel di
# channel Discord. Kosongkan kalau tidak mau pakai fitur stok live - bot tetap jalan normal.
ROBLOX_COOKIE=
